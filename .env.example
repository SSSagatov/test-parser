# Local defaults. Docker Compose supplies its own DATABASE_URL.
# Optional values are commented out; do not replace them with empty strings.
# OWS_TOKEN must be issued by the official Electronic Finance Center.
# List settings use JSON arrays. No real credentials belong in this file.

DATABASE_URL="postgresql+asyncpg://procurement:procurement@localhost:5432/procurement"
PORTAL_URL="https://zakup.gov.kz"
OFFICIAL_HOSTS=["zakup.gov.kz", "goszakup.gov.kz", "old.goszakup.gov.kz", "ows.goszakup.gov.kz", "v3bl.goszakup.gov.kz"]
PUBLIC_API_PATH="/api/core/api/public/"
PUBLIC_SYSTEM_NAME="ЭГЗ"
PUBLIC_RESULT_WINDOW=10000
API_ANNOUNCEMENT_CACHE_SIZE=64
LEGACY_PORTAL_URL="https://old.goszakup.gov.kz"
# SEARCH_URL=
SOURCE_MODE="auto"
OWS_URL="https://ows.goszakup.gov.kz/v3/graphql"
# OWS_TOKEN=
REQUEST_TIMEOUT=45.0
CONCURRENCY=4
DOWNLOAD_CONCURRENCY=3
REQUESTS_PER_SECOND=2.0
RETRY_ATTEMPTS=4
RETRY_MAX_WAIT=60.0
PAGE_SIZE=100
DATABASE_BATCH_SIZE=100
DATABASE_POOL_SIZE=5
BROWSER="chromium"
BROWSER_HEADLESS=true
BROWSER_WAIT_MS=2000
# PROXY=
USER_AGENT="KazakhstanProcurementParser/0.1 (+official-data research)"
RESPECT_ROBOTS=true
DOWNLOAD_FOLDER="data/downloads"
EXPORT_FOLDER="data/exports"
LOG_FOLDER="logs"
MAX_DOWNLOAD_BYTES=104857600
MAX_RESPONSE_BYTES=33554432
MAX_ARCHIVE_MEMBERS=500
MAX_ARCHIVE_DEPTH=3
MAX_EXTRACTED_BYTES=209715200
OCR_LANGUAGES="rus+kaz+eng"
OCR_DPI=200
OCR_TIMEOUT=120
LIBREOFFICE_BINARY="libreoffice"
TESSERACT_BINARY="tesseract"
TIMEZONE="Asia/Almaty"
ACTIVE_STATUSES=["Опубликован", "Прием заявок", "Опубликовано (прием ценовых предложений)", "Опубликовано (прием заявок)", "Опубликован (прием заявок)", "Қабылдау", "active"]
INACTIVE_STATUS_FRAGMENTS=["отмен", "заверш", "итог", "состоял", "cancel", "complet", "аяқтал", "жойыл"]
PAVLODAR_PATTERN="(?<!\\w)г\\s*\\.\\s*Павлодар(?![\\w-])"
STRICT_DEADLINE_DAYS=3
RISK_HIGH_TERMS=["строительств", "реконструкц", "капитальный ремонт", "сложное оборудование", "большой объем работ"]
RISK_MEDIUM_TERMS=["монтаж", "установк", "настройк", "сертификат", "конфигурац", "специальная доставк"]
RISK_STANDARD_TERMS=["бумаг", "канцеляр", "картридж", "мебель", "продукт", "стандарт"]
SUMMARY_CHARACTERS=1500
MAX_PDF_PAGE_PIXELS=40000000
OCR_MIN_TEXT_CHARACTERS=32
OCR_IMAGE_COVERAGE=0.35
MAX_SPREADSHEET_CELLS=5000000

# Docker-only connection string; keep in sync if changing POSTGRES_* values.
COMPOSE_DATABASE_URL=postgresql+asyncpg://procurement:procurement@postgres:5432/procurement
POSTGRES_DB=procurement
POSTGRES_USER=procurement
POSTGRES_PASSWORD=procurement
